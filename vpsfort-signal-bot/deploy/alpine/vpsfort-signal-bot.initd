#!/sbin/openrc-run
# vpsfort-signal-bot on OpenRC (Alpine): what deploy/vpsfort-signal-bot.service does under systemd.
# The settings come from /opt/vpsfort-signal-bot/config.env (exported to the bot, as EnvironmentFile=
# does); the bot writes its own log (LOG_DIR). Supervised: started again 5 seconds after a
# crash. systemd's sandboxing (ProtectSystem, MemoryMax, ...) has no OpenRC equivalent here.
#   rc-update add vpsfort-signal-bot default && rc-service vpsfort-signal-bot start
description="Signal bot delivering vpsfort's admin messages through signal-cli"
supervisor=supervise-daemon
command=/opt/vpsfort-signal-bot/vpsfort-signal-bot
command_user="vpsfort-signal-bot:vpsfort-signal-bot"
directory=/opt/vpsfort-signal-bot
respawn_delay=5
respawn_max=0
config=/opt/vpsfort-signal-bot/config.env

depend() {
    need net
    use dns vpsfort
}

start_pre() {
    if [ ! -r "$config" ]; then
        eerror "$config is missing: copy the template next to it and fill it in"
        return 1
    fi
    # the settings, for the bot only (supervise-daemon passes its environment on)
    set -a
    . "$config"
    set +a
}
