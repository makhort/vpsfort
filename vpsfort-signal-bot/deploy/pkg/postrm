#!/bin/bash
# vpsfort-signal-bot's package, after its files are removed. dpkg runs it as  postrm remove|purge|
# upgrade..., rpm as %postun with 0 (removal) or 1 (upgrade): the same script for both.
# config.env, the state, the keys, the outbox and the log stay on removal; dpkg's purge takes
# them too (rpm has no purge: remove them by hand). The system user stays either way
# (userdel vpsfort-signal-bot removes it).
set -eu
case ${1:-} in
    remove | 0)
        if [ -d /run/systemd/system ] && command -v systemctl > /dev/null; then
            systemctl daemon-reload 2> /dev/null || true
        fi
        echo "vpsfort-signal-bot: /opt/vpsfort-signal-bot and /var/log/vpsfort-signal-bot stay (dpkg: apt purge vpsfort-signal-bot removes them)"
        ;;
    purge)
        rm -rf /opt/vpsfort-signal-bot /var/log/vpsfort-signal-bot
        rm -f /etc/logrotate.d/vpsfort-signal-bot
        ;;
esac
exit 0
