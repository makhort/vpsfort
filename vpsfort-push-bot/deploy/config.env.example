# vpsfort-push-bot's settings: /opt/vpsfort-push-bot/config.env, read by vpsfort-push-bot.service
# (EnvironmentFile). root:vpsfort-push-bot 640, since it holds the token. `vpsfort-push-bot --help`
# describes each option. install.sh copies this file there on the first install; it doesn't
# start the bot while PUSH_URL still holds the placeholder below.

# --- The service --------------------------------------------------------------------------

# ntfy (a server of your own, or ntfy.sh), gotify (a server of your own) or webhook (any
# HTTPS endpoint that takes a JSON POST). None of them encrypts end to end: the service reads
# what the bot sends, so alerts go sanitized (below) and files only OpenPGP-encrypted.
PUSH_KIND=ntfy
# ntfy: the topic's URL (pick a long random topic name: whoever guesses it reads the alerts);
# Gotify: the server's URL; webhook: the URL to POST to. https, or http to localhost.
PUSH_URL=REPLACE_WITH_https://ntfy.example.org/a-long-random-topic
# ntfy: an access token (`ntfy token add`), or the password of PUSH_USER; Gotify: the
# application token; webhook: sent as a Bearer token. Empty: no authentication (a public
# ntfy topic). Treat it like a password.
PUSH_TOKEN=
# Or keep the token in its own file (root:vpsfort-push-bot 640) and leave PUSH_TOKEN empty.
#PUSH_TOKEN_FILE=/opt/vpsfort-push-bot/token
# ntfy with a user and password instead of a token: the user (PUSH_TOKEN is the password).
PUSH_USER=

# --- What reaches the service -------------------------------------------------------------

# The XMPP domains, separated by commas. Every address-like name@domain in an alert becomes
# a pseudonym; a bare user name (ejabberd:alice) is taken as on the first domain.
XMPP_DOMAINS=example.org

# Each server's own addresses and host names, replaced in alerts and digests by its node id
# (vpsfort's [cluster] node_id): node=address,address,name; ... Subdomains are included
# (nextcloud.example.org:443 becomes nextcloud.xmpp:443). List every public IPv4 and IPv6
# address of each server. Node ids need a letter other than a-f; loopback and 0.0.0.0 / ::
# are refused.
SERVER_NAMES=xmpp=192.0.2.10,example.org; vpn=198.51.100.20

# Your OpenPGP public key, exported from OpenKeychain (Android) or iPGMail (iPhone): armored
# or binary, a v4 key, RSA or Curve25519. Files (the weekly abuse report) go out encrypted to
# it as a whole, or not at all: without this setting they wait and expire unsent. A key that
# is missing, expired or revoked stops the bot (exit 78). root:vpsfort-push-bot 640; restart
# the bot after changing it. Gotify takes no attachments: files stay on the server there.
OPENPGP_KEY=/opt/vpsfort-push-bot/admin.asc

# An alert that waited longer than this (bot down, the service out of reach) is dropped,
# and one message says how many were. vpsfort's actions log has them.
ALERT_MAX_HOURS=24

# A file (the weekly abuse report) that waited longer than this (no key, the service out of
# reach, Gotify) is deleted unsent.
OUTBOX_MAX_DAYS=7

# --- Files on the server ------------------------------------------------------------------

# What vpsfort writes for the bot: [notify] push_outbox in /etc/vpsfort/vpsfort.toml and
# ABUSE_REPORT_PUSH_OUTBOX in /etc/default/vpsfort-abuse-report must name the same directory.
OUTBOX_DIR=/opt/vpsfort-push-bot/outbox
# The key behind the pseudonyms, made on the first start. Keep it: a new key gives every
# account a new pseudonym.
PSEUDONYM_KEY=/opt/vpsfort-push-bot/pseudonym.key
# bot.log goes here (14 days, see /etc/logrotate.d/vpsfort-push-bot); install.sh creates it.
LOG_DIR=/var/log/vpsfort-push-bot
