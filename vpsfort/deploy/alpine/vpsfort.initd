#!/sbin/openrc-run
# vpsfort on OpenRC (Alpine): what deploy/vpsfort.service does under systemd. Alpine has
# no journal: the config's [journal] syslog_file names the syslog file to follow (the Alpine
# template sets /var/log/messages), and vpsfort's own messages go to
# /var/log/vpsfort/daemon.log. Supervised: started again 5 seconds after a crash. The
# unit's sandboxing and capability bound have no OpenRC equivalent here.
#   vpsfort -c /etc/vpsfort/vpsfort.toml print-config > /dev/null && rc-update add vpsfort default && rc-service vpsfort start
description="Behaviour-based protection for SSH, XMPP, firewall and application logs"
supervisor=supervise-daemon
command=/usr/bin/vpsfort
command_args="--config /etc/vpsfort/vpsfort.toml run"
respawn_delay=5
respawn_max=0
output_log=/var/log/vpsfort/daemon.log
error_log=/var/log/vpsfort/daemon.log

depend() {
    need net
    after firewall iptables nftables syslog
}

start_pre() {
    checkpath -d -m 0700 -o root:root /run/vpsfort /var/lib/vpsfort
    checkpath -d -m 0750 -o root:root /var/log/vpsfort
    # vpsfort's messages name addresses, accounts and decisions: root's and the group's only
    checkpath -f -m 0640 -o root:root /var/log/vpsfort/daemon.log
    /usr/bin/vpsfort --config /etc/vpsfort/vpsfort.toml print-config > /dev/null
}
