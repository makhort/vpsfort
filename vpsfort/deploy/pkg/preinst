#!/bin/bash
# vpsfort's package, before its files are unpacked. dpkg runs it as  preinst install|upgrade
# [old-version], rpm as %pre with 1 (first install) or 2 (upgrade): the same script for both.
# Saves the running version's defaults, so postinst's config-diff can tell new options and
# changed defaults apart (as the bundle's install.sh does). The old binary is the package's
# (/usr/bin/vpsfort) or a bundle's or deploy.sh's (/usr/local/bin/vpsfort), which the package
# takes over.
set -eu
for old in /usr/bin/vpsfort /usr/local/bin/vpsfort; do
    if [ -x "$old" ] && [ -f /etc/vpsfort/vpsfort.toml ]; then
        mkdir -p -m 0700 /run/vpsfort-package
        env -u VPSFORT_CONFIG "$old" print-config > /run/vpsfort-package/old-defaults 2> /dev/null \
            || rm -f /run/vpsfort-package/old-defaults
        break
    fi
done
exit 0
