# vpsfort-web settings: /opt/vpsfort-web/config.env (root:vpsfort-web, mode 0640).
# The unit reads it as its EnvironmentFile; `vpsfort-web --help` lists every option.
# `vpsfort-web check` (and passwd, totp-setup, ...) read it the same way: each value is the
# whole rest of its line, so lists may have blanks after their commas. Don't source this file
# in a shell: there `AGENT_ALLOW=192.0.2.1, 192.0.2.2` runs a command named "192.0.2.2".
#
# Every node of the cluster runs the agent: it hands this node's vpsfort data to the consoles.
# One node (or two) also runs the console: the web page for the admin, with the whole cluster.
# Nothing here can ban, unban or allow: the console only reads.

# ---------------------------------------------------------------- every node

# This node's name in the console. Empty: vpsfort's [cluster] node_id, else the host name.
NODE_NAME=

# vpsfort's read-only console socket: in /etc/vpsfort/vpsfort.toml set
#   [console]
#   socket = "/run/vpsfort-console/console.sock"
#   group = "vpsfort-web"
# and restart vpsfort. Empty on a console host without vpsfort.
VPSFORT_SOCKET=/run/vpsfort-console/console.sock

# The web key: the same file on every node. Make it once, on one node:
#   /opt/vpsfort-web/vpsfort-web keygen --out /opt/vpsfort-web/web.key
# and copy that file to the others (bash install.sh again sets its owner and mode). Compare
# `vpsfort-web key-id` on each. It is NOT vpsfort's cluster key: that one makes bans on every
# node, and a web console must never hold it.
WEB_KEY_FILE=/opt/vpsfort-web/web.key

# ---------------------------------------------------------------- agent (every node)

# Where the consoles ask for this node's data; empty: no agent (the console's own node: the
# console reads its vpsfort through VPSFORT_SOCKET).
# Open the port to the console's address only:  ufw allow from 203.0.113.10 to any port 7949 proto tcp
AGENT_LISTEN=0.0.0.0:7949
# The consoles' addresses or networks, separated by commas or blanks. "any": every address may
# try, the web key alone decides (consoles behind changing addresses).
AGENT_ALLOW=REPLACE-with-the-console-address

# ---------------------------------------------------------------- console (one node)

# Where the console serves HTTPS; empty: no console here.
# 127.0.0.1:7948 is reached through an SSH tunnel (ssh -L 7948:127.0.0.1:7948 host); for
# the network, 0.0.0.0:7948 with CONSOLE_ALLOW and a firewall rule for the admin's addresses.
CONSOLE_LISTEN=
# The addresses or networks the admin connects from; empty: every address sees the login page
# (failed logins are locked out, and vpsfort bans them with [sources] apps = ["vpsfort-web"]).
CONSOLE_ALLOW=
# The other nodes' agents (host:port), separated by commas or blanks. This node's own vpsfort
# comes from VPSFORT_SOCKET.
NODES=

# The console's certificate. install.sh makes a self-signed one on the first install (compare
# its fingerprint with the browser's: `vpsfort-web fingerprint`), or point these at a
# Let's Encrypt certificate the vpsfort-web group can read (it is read again when renewed).
TLS_CERT=/opt/vpsfort-web/tls.crt
TLS_KEY=/opt/vpsfort-web/tls.key

# The admin's password (Argon2id):  /opt/vpsfort-web/vpsfort-web passwd
PASSWORD_FILE=/opt/vpsfort-web/admin.password
# A one-time code from an authenticator app too (on), or the password only (off), for every admin.
#   /opt/vpsfort-web/vpsfort-web totp-setup     (shows a QR code)
TOTP=on
TOTP_FILE=/opt/vpsfort-web/admin.totp
# More admins, all equal (no roles), each with a password and codes of their own, kept here:
#   /opt/vpsfort-web/vpsfort-web passwd --user alice
#   /opt/vpsfort-web/vpsfort-web totp-setup --user alice
#   /opt/vpsfort-web/vpsfort-web admins          (and remove-admin alice)
ADMINS_DIR=/opt/vpsfort-web/admins

# Proof of work before each login: the browser finds a hash with this many leading zero bits
# (20: under a second on a laptop, a few on a phone), the console checks it with one hash before
# any password check; each failed login lately adds bits for that address and account. 0: off.
#LOGIN_WORK=20

# Abuse mailboxes (the Abuse tab's Mail): the console asks rdap.org (on), or leaves it to the
# admin's browser (off; it asks rdap.org itself then, as it does when the console can't get out).
#RDAP_LOOKUPS=on

# Prometheus: a token (vpsfort-web keygen --out /opt/vpsfort-web/metrics.token) that reads
# /metrics without a login, sent as "Authorization: Bearer <token>". Unset: logged-in only.
#METRICS_TOKEN_FILE=/opt/vpsfort-web/metrics.token

# The console asks the nodes again after this many seconds, only while a page is open.
REFRESH_SECS=10
# A session ends after this many idle minutes, and this many hours after the login.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

#STATE_DIR=/var/lib/vpsfort-web
