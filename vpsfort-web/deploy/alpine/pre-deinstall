#!/bin/sh
# vpsfort-web's Alpine package, before its files are removed (apk runs this as
# .pre-deinstall; an upgrade runs .pre-upgrade instead). The service stops and leaves the
# boot runlevel; /opt/vpsfort-web (config.env, keys, certificate) and the state stay.
if command -v rc-service > /dev/null; then
    rc-service vpsfort-web stop > /dev/null 2>&1 || true
    rc-update del vpsfort-web default > /dev/null 2>&1 || true
fi
exit 0
