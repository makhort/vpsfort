# vpsfort-xmpp-bot's settings: /opt/vpsfort-xmpp-bot/config.env, read by
# vpsfort-xmpp-bot.service (EnvironmentFile). root:ejabberd 640: it holds the bot's password.
# `vpsfort-xmpp-bot --help` describes each option. The release bundle's install.sh copies
# this file there on the first install and doesn't install the bot while values below still
# start with REPLACE.
#
# This is the admin bot, on the XMPP server (ejabberd). For the client bot (a copy bot like
# vpsfort-tg-bot, on any host and XMPP server): config-client.env.example.
#
# An ejabberd with several domains (`hosts`) runs one admin bot per domain: this file is the
# first one's, /opt/vpsfort-xmpp-bot/instances/<name>/config.env each other's (made from this
# template by  install.sh --instance <name>; README, "Several domains").

BOT_MODE=admin

# --- The bot's account ----------------------------------------------------------------------

# Create it first:  ejabberdctl register bot example.org 'a long random password'
# Not one of vpsfort's [canary] xmpp names (test, info, user, xmpp, ...): install.sh refuses it.
BOT_JID=REPLACE_WITH_THE_BOTS_JID
BOT_PASSWORD=REPLACE_WITH_THE_BOTS_PASSWORD
# Or keep the password in its own file (root:ejabberd 640) and drop BOT_PASSWORD above;
# setting both is an error.
#BOT_PASSWORD_FILE=/opt/vpsfort-xmpp-bot/password
# Sort name in the bot's vCard.
BOT_NAME=Admin Bot

# The admin's bare JID: the only one with the admin commands. An account on any domain of this
# server (one admin account can run the bots of all of them), never on another server.
ADMIN_JID=REPLACE_WITH_THE_ADMINS_JID

# --- The server -----------------------------------------------------------------------------

# Host to connect to; the certificate is still checked against XMPP_DOMAIN.
XMPP_SERVER=127.0.0.1
# The domain the bot manages accounts of; its users are the ones who may use it.
XMPP_DOMAIN=REPLACE_WITH_THE_XMPP_DOMAIN
# 5223: TLS from the first byte (XMPP_TLS=auto picks it on this port); 5222: STARTTLS.
XMPP_PORT=5223
#XMPP_TLS=auto
#EJABBERDCTL=/usr/sbin/ejabberdctl
# ejabberd's SQLite database (sql_database in ejabberd.yml), read-only, for /export's JSON
# file; needs sqlite3 (apt install sqlite3, or dnf install sqlite). Unset: /export sends a text summary only.
#EJABBERD_DB=/opt/ejabberd/database/example.org.v2.db
# mod_invites' web page, given by /invite [default: https://<domain>:5281/invites].
#INVITE_URL=

# --- Files ----------------------------------------------------------------------------------

# The state file; its directory also holds the OMEMO keys (omemo.json), the pins
# (omemo-trust.txt) and the outbox. Unset: state.json in this file's directory (the unit's
# default). Each bot needs its own: a second one on the same directory doesn't start (exit 78).
#BOT_STATE_PATH=/opt/vpsfort-xmpp-bot/state.json
#LOG_DIR=/var/log/vpsfort-xmpp-bot
# Organisation in the bot's vCard (with the domain as its unit).
#ORG_NAME=
# PNG, JPEG, GIF, WebP, BMP or TIFF.
#AVATAR_PATH=/opt/vpsfort-xmpp-bot/avatar.png

# --- OMEMO ----------------------------------------------------------------------------------

# off; on (encrypted and plain commands); required (plain commands refused).
#OMEMO=on
# blind: a JID without pins is trusted on any key; pinned: only keys in OMEMO_TRUST_FILE.
#OMEMO_TRUST=blind

# --- What /privacy tells users (keep in step with the server's settings) ------------------

#RETENTION_MESSAGE_DAYS=21
#RETENTION_FILE_DAYS=7
#UPLOAD_MAX_MB=500
#RETENTION_ACCOUNT_DAYS=90
#RETENTION_ROOM_DAYS=90
#ABUSE_REPORT_DAYS=90
#SECURITY_RECORD_DAYS=84

# Languages of server announcements (/maintenance, /restart, /warn), in order.
#ANNOUNCE_LANGUAGES=EN,FR,RU,UK
