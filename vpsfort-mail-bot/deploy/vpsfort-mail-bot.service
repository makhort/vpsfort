[Unit]
Description=Mail bot for vpsfort's admin messages (send-only, OpenPGP-encrypted)
After=network-online.target
Wants=network-online.target
# the local Postfix, if that is the way out
After=postfix.service

[Service]
Type=simple
# Its own user: no access to vpsfort's, ejabberd's or Postfix's files. install.sh creates
# it and sets the owners and modes of /opt/vpsfort-mail-bot.
User=vpsfort-mail-bot
Group=vpsfort-mail-bot
WorkingDirectory=/opt/vpsfort-mail-bot
EnvironmentFile=/opt/vpsfort-mail-bot/config.env
ExecStart=/opt/vpsfort-mail-bot/vpsfort-mail-bot

Restart=always
RestartSec=5
# 78: the mail server refused the login, a key is missing or unusable, or a bad setting.
# Restarting would not help (and repeated failed logins can get this address banned there).
RestartPreventExitStatus=78

# Hardening: the bot reads its outbox and keys and talks SMTP to one server, nothing else.
CapabilityBoundingSet=
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ReadWritePaths=/opt/vpsfort-mail-bot /var/log/vpsfort-mail-bot
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# At most this much memory (a small Rust program: alerts, a weekly report and the keys): the kernel
# reclaims above MemoryHigh and ends the service above MemoryMax, so a leak or a flood of
# messages can't take the host's memory from the services it protects.
MemoryHigh=96M
MemoryMax=128M

[Install]
WantedBy=multi-user.target
