#!/sbin/openrc-run
# vpsfort-mail-bot on OpenRC (Alpine): what deploy/vpsfort-mail-bot.service does under systemd.
# The settings come from /opt/vpsfort-mail-bot/config.env (exported to the bot, as EnvironmentFile=
# does); the bot writes its own log (LOG_DIR). Supervised: started again 5 seconds after a
# crash. systemd's sandboxing (ProtectSystem, MemoryMax, ...) has no OpenRC equivalent here.
#   rc-update add vpsfort-mail-bot default && rc-service vpsfort-mail-bot start
description="Send-only mail bot delivering vpsfort's admin messages, OpenPGP-encrypted"
supervisor=supervise-daemon
command=/opt/vpsfort-mail-bot/vpsfort-mail-bot
command_user="vpsfort-mail-bot:vpsfort-mail-bot"
directory=/opt/vpsfort-mail-bot
respawn_delay=5
respawn_max=0
config=/opt/vpsfort-mail-bot/config.env

depend() {
    need net
    use dns vpsfort
}

start_pre() {
    if [ ! -r "$config" ]; then
        eerror "$config is missing: copy the template next to it and fill it in"
        return 1
    fi
    # the settings, for the bot only (supervise-daemon passes its environment on)
    set -a
    . "$config"
    set +a
}
