[Unit]
Description=Matrix bot for vpsfort's admin messages (end-to-end encrypted)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own user: no ejabberd group, no access to ejabberd's files. install.sh creates it
# and sets the owners and modes of /opt/vpsfort-matrix-bot.
User=vpsfort-matrix-bot
Group=vpsfort-matrix-bot
WorkingDirectory=/opt/vpsfort-matrix-bot
EnvironmentFile=/opt/vpsfort-matrix-bot/config.env
ExecStart=/opt/vpsfort-matrix-bot/vpsfort-matrix-bot

Restart=always
RestartSec=5
# 78: the homeserver no longer knows the login (run `vpsfort-matrix-bot login`), or a bad
# setting. Restarting would not help.
RestartPreventExitStatus=78

# Hardening: the bot reads its outbox and talks HTTPS to the homeserver, nothing else.
CapabilityBoundingSet=
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ReadWritePaths=/opt/vpsfort-matrix-bot /var/log/vpsfort-matrix-bot
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# At most this much memory (a small Rust program: alerts, a weekly report and the keys): the kernel
# reclaims above MemoryHigh and ends the service above MemoryMax, so a leak or a flood of
# messages can't take the host's memory from the services it protects.
MemoryHigh=96M
MemoryMax=128M

[Install]
WantedBy=multi-user.target
