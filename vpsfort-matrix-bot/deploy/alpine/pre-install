#!/bin/sh
# vpsfort-matrix-bot's Alpine package, before its files are unpacked: the system user of its own,
# without a home or a shell (apk runs this as .pre-install and .pre-upgrade).
if ! id vpsfort-matrix-bot > /dev/null 2>&1; then
    addgroup -S vpsfort-matrix-bot 2> /dev/null || true
    adduser -S -D -H -s /sbin/nologin -G vpsfort-matrix-bot -g "vpsfort-matrix-bot" vpsfort-matrix-bot
    echo "vpsfort-matrix-bot: created the system user vpsfort-matrix-bot"
fi
exit 0
